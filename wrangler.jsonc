{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sip-ikp",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-26",
  "send_metrics": false,
  "vars": {
    "APP_ENV": "development",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sip-ikp-d1",
      "database_id": "1fb4f6c9-cb7d-4589-81fe-5a6f091982bb",
      "migrations_dir": "./database/migrations",
      // Local Pages development reads the existing Cloudflare D1 data.
      // This flag is ignored for deployed bindings.
      "remote": true,
    },
  ],
}
