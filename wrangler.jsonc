{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sip-ikp",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-26",
  "send_metrics": false,
  "vars": {
    "APP_ENV": "development",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sip-ikp-d1",
      "database_id": "local-sip-ikp-d1",
      "migrations_dir": "./database/migrations",
    },
  ],
}
