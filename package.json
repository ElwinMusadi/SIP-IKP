{
  "name": "sip-ikp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fondasi aplikasi Sistem Informasi Pelaporan Insiden Keselamatan Pasien IBS RSUD Prof. Dr. W. Z. Johannes Kupang.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev dist --d1 DB --r2 R2_BUCKET",
    "cf:validate": "wrangler pages functions build --outdir .wrangler/tmp/functions-build",
    "cf:types": "wrangler types --env-interface CloudflareEnv src/types/cloudflare-env.d.ts",
    "d1:harness:setup": "node --experimental-strip-types test-support/d1/harness.ts setup",
    "d1:harness:reset": "node --experimental-strip-types test-support/d1/harness.ts reset",
    "d1:harness:seed": "node --experimental-strip-types test-support/d1/harness.ts seed",
    "d1:harness:teardown": "node --experimental-strip-types test-support/d1/harness.ts teardown",
    "d1:harness:validate": "node --experimental-strip-types test-support/d1/harness.ts validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.1",
    "wrangler": "^4.141.0"
  }
}
