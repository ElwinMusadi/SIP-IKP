# Public Vite variables only. Every VITE_ value is bundled into client code.
VITE_APP_NAME="SIP-IKP IBS"
VITE_APP_ENV="development"
VITE_API_BASE_PATH="/api"

# Non-secret Pages Functions metadata for local development.
APP_ENV="development"

# Never add passwords, session keys, Cloudflare API tokens, D1 IDs, or R2 credentials here.
# Local secrets belong in an ignored .dev.vars file. Production secrets belong in Cloudflare.
